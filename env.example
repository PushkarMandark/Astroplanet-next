# Environment Configuration for AstroPlanet Next.js
# Copy this to .env.local and update values

# Site Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=AstroPlanet

# WordPress Backend
NEXT_PUBLIC_WP_URL=https://backend.astroplanet.in
WP_API_BASE=https://backend.astroplanet.in/wp-json

# WooCommerce API (server-side only - no NEXT_PUBLIC_ prefix)
WC_CONSUMER_KEY=ck_your_consumer_key
WC_CONSUMER_SECRET=cs_your_consumer_secret

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key

# Debug Mode
NEXT_PUBLIC_DEBUG=false
