Options -MultiViews
RewriteEngine On

# ── Security Headers ──────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://api.astroeshop.com https://*.openstreetmap.org https://*.wp.com; connect-src 'self' https://api.astroeshop.com https://nominatim.openstreetmap.org https://ohmanda.com https://cloudflareinsights.com https://*.cloudflareinsights.com; frame-src https://www.google.com https://www.youtube.com; font-src 'self' https://fonts.gstatic.com"
</IfModule>

# ── Canonical host: apex → www (301) ─────────────────
RewriteCond %{HTTP_HOST} ^astroeshop\.com$ [NC]
RewriteRule ^(.*)$ https://www.astroeshop.com/$1 [R=301,L]

# ── Legacy free-tool URL renames (2026-04 → SEO-friendly slugs) ──
RedirectMatch 301 ^/kundli/?$ /free-kundli-calculator/
RedirectMatch 301 ^/compatibility/?$ /free-match-making-calculator/
RedirectMatch 301 ^/horoscope/?$ /free-horoscope/
RedirectMatch 301 ^/numerology/?$ /free-numerology-calculator/

# ── Force HTTPS (uncomment once SSL is confirmed working) ─
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Custom error documents ───────────────────────────
ErrorDocument 404 /404.html

# ── Static asset caching ─────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Immutable caching for fingerprinted Next.js chunks
<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|woff2|woff)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ── Routing rules ────────────────────────────────────
# If the request is for an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# For paths without a trailing slash that aren't files, add trailing slash
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^.]+[^/])$ /$1/ [R=301,L]

# Serve the index.html inside each directory
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]
